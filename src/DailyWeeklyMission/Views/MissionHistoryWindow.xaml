<Window x:Class="DailyWeeklyMission.Views.MissionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mission History"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FEF3C7" Offset="0"/>
                <GradientStop Color="#FDE68A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border Margin="32" Background="{StaticResource Amber50}"
                CornerRadius="8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ?? ??댄?諛??? -->
                <Border Grid.Row="0"
                        Background="{StaticResource Amber100}"
                        BorderBrush="{StaticResource Amber300}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Mission History"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray800}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="BtnClose_Click">
                            <Path Data="M18 6 6 18M6 6l12 12"
                                  Stroke="{StaticResource Gray700}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Fill="Transparent"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ?? 硫붿씤 肄섑뀗痢?(醫? 紐⑸줉 / ?? ?곸꽭) ?? -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 誘몄뀡 紐⑸줉 -->
                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource Amber300}"
                            BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MissionList"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 誘몄뀡 ?곸꽭 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel x:Name="DetailPanel"/>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
