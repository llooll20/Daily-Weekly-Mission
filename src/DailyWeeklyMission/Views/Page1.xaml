<Page x:Class="DailyWeeklyMission.Views.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DailyWeeklyMission.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock Text="Exercise"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="{StaticResource Gray800}" />

            <StackPanel Orientation="Horizontal"
                Margin="0,4,0,24">

                <TextBlock Text="Weekly Mission"
                   FontSize="12"
                   Foreground="{StaticResource Gray600}"
                   VerticalAlignment="Center" />

                <Border Margin="8,0,0,0"
                Padding="8,2"
                CornerRadius="10"
                Background="{StaticResource Green100}">

                    <TextBlock Text="Completed"
                       FontSize="11"
                       Foreground="{StaticResource Green700}" />

                </Border>

            </StackPanel>


            <!-- Progress -->
            <Border Background="{StaticResource Amber100}"
            CornerRadius="8"
            Padding="16">

                <StackPanel>

                    <!-- 제목 + 수치 -->
                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Progress"
                           FontSize="12"
                           Foreground="{StaticResource Gray700}" />

                        <TextBlock Grid.Column="1"
                           Text="3 / 3"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Gray800}" />

                    </Grid>

                    <!-- ProgressBar -->
                    <ProgressBar Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="100"
                         BorderThickness="0"
                         Background="{StaticResource Amber200}"
                         Foreground="{StaticResource Blue500}" />

                    <TextBlock Text="100% Complete"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource Gray600}" />

                </StackPanel>

            </Border>


            <!-- Period -->
            <StackPanel Margin="0,24,0,0">

                <TextBlock Text="Period"
                   FontSize="12"
                   FontWeight="Medium"
                   Foreground="{StaticResource Gray700}"
                   Margin="0,0,0,6"/>

                <Border Background="{StaticResource Amber50}"
                BorderBrush="{StaticResource Amber200}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">

                    <TextBlock>

                <Run Text="2026-05-25"/>
                <Run Text=" ~ "/>
                <Run Text="2026-05-31"/>

                    </TextBlock>

                </Border>

            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
