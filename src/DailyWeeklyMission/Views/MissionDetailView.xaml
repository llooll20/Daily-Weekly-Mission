<UserControl x:Class="DailyWeeklyMission.Views.MissionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="500">

    <Grid>
        <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock Text="{Binding Title}"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="{StaticResource Gray800}" />

            <StackPanel Orientation="Horizontal"
                Margin="0,4,0,24">

                <TextBlock Text="{Binding MissionType}"
                   FontSize="12"
                   Foreground="{StaticResource Gray600}"
                   VerticalAlignment="Center" />

                <Border Margin="8,0,0,0"
                Padding="8,2"
                CornerRadius="10"
                Background="{StaticResource Green100}">

                    <TextBlock Text="{Binding IsCompleted }"
                       FontSize="11"
                       Foreground="{StaticResource Green600}" />

                </Border>

            </StackPanel>


            <!-- Progress -->
            <Border Background="{StaticResource Amber100}"
            CornerRadius="8"
            Padding="16">

                <StackPanel>

                    <!-- 제목 + 수치 -->
                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Progress"
                           FontSize="12"
                           Foreground="{StaticResource Gray700}" />

                        <TextBlock Grid.Column="1"
                           Text="{Binding ProgressText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Gray800}" />

                    </Grid>

                    <!-- ProgressBar -->
                    <ProgressBar Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         BorderThickness="0"
                         Background="{StaticResource Amber200}"
                         Foreground="{StaticResource Blue500}" />

                    <TextBlock Text="{Binding ProgressPercentage}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource Gray600}" />

                </StackPanel>

            </Border>


            <!-- Period -->
            <StackPanel Margin="0,24,0,0">

                <TextBlock Text="Period"
                   FontSize="12"
                   FontWeight="Medium"
                   Foreground="{StaticResource Gray700}"
                   Margin="0,0,0,6"/>

                <Border Background="{StaticResource Amber50}"
                BorderBrush="{StaticResource Amber200}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">

                    <TextBlock>

                <Run Text="{Binding StartDate, StringFormat='yyyy-MM-dd'}"/>
                <Run Text=" ~ "/>
                <Run Text="{Binding EndDate, StringFormat='yyyy-MM-dd'}"/>

                    </TextBlock>

                </Border>

            </StackPanel>
            <StackPanel Margin="0,24,0,0">

                <!-- 제목 -->
                <TextBlock
        FontSize="12"
        FontWeight="Medium"
        Foreground="{StaticResource Gray700}">

        <Run Text="Completed Dates ("/>
        <Run Text="{Binding CalendarDaysCompletedCount, Mode=OneWay}"/>
        <Run Text=")"/>

                </TextBlock>

                <Border
        Margin="0,8,0,0"
        Padding="12"
        Background="{StaticResource Amber50}"
        BorderBrush="{StaticResource Amber200}"
        BorderThickness="1"
        CornerRadius="8">

                    <StackPanel>

                        <!-- 월 이동 -->
                        <Grid Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button
                    Content="〈"
                    Style="{StaticResource CalendarNavButtonStyle}"
                    Command="{Binding PreviousMonthCommand}" />

                            <TextBlock
                    Grid.Column="1"
                    Text="{Binding CurrentMonth}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                            <Button
                    Grid.Column="2"
                    Content="〉"
                    Style="{StaticResource CalendarNavButtonStyle}"
                    Command="{Binding NextMonthCommand}" />

                        </Grid>

                        <!-- 요일 -->
                        <UniformGrid Columns="7">

                            <TextBlock Text="S" HorizontalAlignment="Center"/>
                            <TextBlock Text="M" HorizontalAlignment="Center"/>
                            <TextBlock Text="T" HorizontalAlignment="Center"/>
                            <TextBlock Text="W" HorizontalAlignment="Center"/>
                            <TextBlock Text="T" HorizontalAlignment="Center"/>
                            <TextBlock Text="F" HorizontalAlignment="Center"/>
                            <TextBlock Text="S" HorizontalAlignment="Center"/>

                        </UniformGrid>

                        <!-- 날짜 -->
                        <ItemsControl ItemsSource="{Binding CalendarDays}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border
                            Width="28"
                            Height="28"
                            Margin="1"
                            CornerRadius="14">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>

                                                    <!-- 완료 -->
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Green500}"/>
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock
                                Text="{Binding Day}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Gray700}"/>
                                                    <Style.Triggers>

                                                        <!-- 완료 -->
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>

                                                        <!-- 이번 달이 아님 -->
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Gray300}"/>
                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </StackPanel>
        </StackPanel>

    </Grid>

</UserControl>
