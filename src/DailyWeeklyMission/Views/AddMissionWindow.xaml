<Window x:Class="DailyWeeklyMission.Views.AddMissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Mission"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Border CornerRadius="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FEF3C7" Offset="0"/>
                <GradientStop Color="#FDE68A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border Margin="5" Background="{StaticResource Amber50}"
                CornerRadius="8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ?? ??댄?諛??? -->
                <Border Grid.Row="0"
                        Background="{StaticResource Amber100}"
                        BorderBrush="{StaticResource Amber300}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Add Mission"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray800}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="BtnClose_Click">
                            <Path Data="M18 6 6 18M6 6l12 12"
                                  Stroke="{StaticResource Gray700}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Fill="Transparent"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ?? ??肄섑뀗痢??? -->
                <StackPanel Grid.Row="1" Margin="14">

                    <!-- Mission Title -->
                    <StackPanel>
                        <TextBlock Text="Mission Title"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Gray700}"/>
                        <TextBox x:Name="TxtTitle"
                                 Style="{StaticResource FormInputStyle}"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Enter mission title"/>
                    </StackPanel>

                    <!-- Mission Content -->
                    <StackPanel>
                        <TextBlock Text="Mission Content"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Gray700}"/>
                        <TextBox x:Name="TxtContent"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"
                                 Background="White"
                                 BorderBrush="{StaticResource Amber300}"
                                 BorderThickness="1"
                                 FontSize="13"
                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                />
                    </StackPanel>

                    <StackPanel x:Name="MissionOptionPanel">
                    <StackPanel x:Name="WeekdayPanel"
                                Visibility="{Binding IsWeeklyMission,
                     Converter={StaticResource BoolToVisibility}}">
                        <!-- Mission Type -->
                    <TextBlock Text="Weekly Mission Type"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{StaticResource Gray700}" />    
                        
                    <StackPanel Margin="0,5,0,10">
                        <RadioButton
                            Content="Specific Days"
                            GroupName="MissionType"
                            IsChecked="{Binding IsDayMode}" />

                        <RadioButton
                            x:Name="RadioCount"
                            Content="Weekly Target Count"
                            GroupName="MissionType"
                            IsChecked="{Binding IsCountMode}" />    
                        
                        <!-- 요일 선택 -->
                        <StackPanel Visibility="{Binding IsDayMode,
                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Select Days"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{StaticResource Gray700}"/>  

                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton
                                            Content="{Binding Text}"
                                            IsChecked="{Binding IsSelected}" /> 
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                        
                    </StackPanel>
                    <!-- Target Count -->
                        <StackPanel x:Name="ShowTargetCount"
                                Visibility="{Binding ShowTargetCount,
                                     Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="Target Count"/>

                        <TextBox
                            Text="{Binding TargetCount}" />

                    </StackPanel>
                    </StackPanel>
                    <!-- Start / End Date -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start Date"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource Gray700}"/>
                            <DatePicker x:Name="DpStart"
                                        Height="34"
                                        Background="White"
                                        BorderBrush="{StaticResource Amber300}"
                                        FontSize="13"
                                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource Gray700}"/>
                            <DatePicker x:Name="DpEnd"
                                        Height="34"
                                        Background="White"
                                        BorderBrush="{StaticResource Amber300}"
                                        FontSize="13"
                                        SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                        />
                        </StackPanel>
                    </Grid>

                    <!-- Cancel / Save -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCancel_Click"/>
                        <Button Grid.Column="2"
                                Content="Save Mission"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnSave_Click"
                                Command="{Binding SaveMissionCommand}" Height="38" VerticalAlignment="Top"
                                />
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
