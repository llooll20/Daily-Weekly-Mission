<Window x:Class="DailyWeeklyMission.Views.AddMissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Mission"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FEF3C7" Offset="0"/>
                <GradientStop Color="#FDE68A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border Margin="32" Background="{StaticResource Amber50}"
                CornerRadius="8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ?? ??댄?諛??? -->
                <Border Grid.Row="0"
                        Background="{StaticResource Amber100}"
                        BorderBrush="{StaticResource Amber300}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Add Mission"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray800}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="BtnClose_Click">
                            <Path Data="M18 6 6 18M6 6l12 12"
                                  Stroke="{StaticResource Gray700}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Fill="Transparent"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ?? ??肄섑뀗痢??? -->
                <StackPanel Grid.Row="1" Margin="24">

                    <!-- Mission Title -->
                    <StackPanel>
                        <TextBlock Text="Mission Title"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Gray700}"/>
                        <TextBox x:Name="TxtTitle"
                                 Style="{StaticResource FormInputStyle}"
                                 Text="{Binding Title, UpdateSourceTrigger=Explicit}"
                                 Tag="Enter mission title"/>
                    </StackPanel>

                    <!-- Mission Content -->
                    <StackPanel>
                        <TextBlock Text="Mission Content"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Gray700}"/>
                        <TextBox x:Name="TxtContent"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"
                                 Background="White"
                                 BorderBrush="{StaticResource Amber300}"
                                 BorderThickness="1"
                                 FontSize="13"
                                 Text="{Binding Content, UpdateSourceTrigger=Explicit}"
                                />
                    </StackPanel>

                    <!-- Mission Type -->
                    <StackPanel>
                        <TextBlock Text="Mission Type"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Gray700}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="BtnTypeDaily"
                                          Grid.Column="0"
                                          Content="Daily"
                                          Style="{StaticResource TypeToggleButtonStyle}"
                                          IsChecked="True"
                                          Click="BtnTypeDaily_Click"/>
                            <ToggleButton x:Name="BtnTypeWeekly"
                                          Grid.Column="2"
                                          Content="Weekly"
                                          Style="{StaticResource TypeToggleButtonStyle}"
                                          Click="BtnTypeWeekly_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ?붿씪 ?좏깮 (Weekly ?좏깮 ?쒕쭔 ?쒖떆) -->
                    <StackPanel x:Name="WeekdayPanel" Visibility="Collapsed">
                        <TextBlock Text="Select Days"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Gray700}"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="M" Style="{StaticResource WeekdayButtonStyle}" Tag="1"/>
                            <ToggleButton Content="T" Style="{StaticResource WeekdayButtonStyle}" Tag="2"/>
                            <ToggleButton Content="W" Style="{StaticResource WeekdayButtonStyle}" Tag="3"/>
                            <ToggleButton Content="T" Style="{StaticResource WeekdayButtonStyle}" Tag="4"/>
                            <ToggleButton Content="F" Style="{StaticResource WeekdayButtonStyle}" Tag="5"/>
                            <ToggleButton Content="S" Style="{StaticResource WeekendButtonStyle}" Tag="6"/>
                            <ToggleButton Content="S" Style="{StaticResource WeekendButtonStyle}" Tag="7"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Target Count -->
                    <StackPanel>
                        <TextBlock Text="Target Count"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Gray700}"/>
                        <TextBox x:Name="TxtTarget"
                                 Style="{StaticResource FormInputStyle}"
                                 Tag="e.g., 3"
                                 Text="{Binding TargetCount, UpdateSourceTrigger=Explicit}"
                                 />
                    </StackPanel>

                    <!-- Start / End Date -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start Date"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource Gray700}"/>
                            <DatePicker x:Name="DpStart"
                                        Height="34"
                                        Background="White"
                                        BorderBrush="{StaticResource Amber300}"
                                        FontSize="13"
                                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource Gray700}"/>
                            <DatePicker x:Name="DpEnd"
                                        Height="34"
                                        Background="White"
                                        BorderBrush="{StaticResource Amber300}"
                                        FontSize="13"
                                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        />
                        </StackPanel>
                    </Grid>

                    <!-- Cancel / Save -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCancel_Click"/>
                        <Button Grid.Column="2"
                                Content="Save Mission"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnSave_Click"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
