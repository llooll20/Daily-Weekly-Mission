<Window x:Class="DailyWeeklyMission.Views.AddMissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Mission"
        Width="760"
        Height="760"
        MinWidth="620"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="NoteBackgroundBrush" Color="#FFF9E8"/>
        <SolidColorBrush x:Key="NoteLineBrush" Color="#F5C542"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F7DF6"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="14 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#F2C438"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="WeekdayButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0 0 18 0"/>
            <Setter Property="Background" Value="#FFE178"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="29">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Background="{StaticResource NoteBackgroundBrush}"
            BorderBrush="#F4D05A"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Add Mission"
                           Margin="22 0"
                           VerticalAlignment="Center"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <Button Grid.Column="1"
                        Content="x"
                        Width="42"
                        Height="42"
                        Margin="0 0 18 0"
                        FontSize="26"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#1F2937"
                        Click="CloseButtonClick"/>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource NoteLineBrush}"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32 32 32 28">
                    <TextBlock Text="Mission Title"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="Enter mission title"
                             Foreground="#7B8490"
                             Style="{StaticResource InputBoxStyle}"/>

                    <TextBlock Text="Mission Content"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0 26 0 8"/>
                    <TextBox Text="Enter mission description"
                             Height="140"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Padding="14 14"
                             Foreground="#7B8490"
                             Style="{StaticResource InputBoxStyle}"/>

                    <TextBlock Text="Target Count"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0 28 0 8"/>
                    <TextBox Text="e.g., 3"
                             Foreground="#7B8490"
                             Style="{StaticResource InputBoxStyle}"/>

                    <Grid Margin="0 26 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start Date"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="yyyy .  mm .  dd ."
                                     Style="{StaticResource InputBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="yyyy .  mm .  dd ."
                                     Style="{StaticResource InputBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0 30 0 0"
                            Padding="18"
                            Background="#FFF3C7"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Select Days"
                                       FontSize="18"
                                       Foreground="#1F2937"
                                       Margin="0 0 0 16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="M" Style="{StaticResource WeekdayButtonStyle}"/>
                                <Button Content="T" Style="{StaticResource WeekdayButtonStyle}"/>
                                <Button Content="W" Style="{StaticResource WeekdayButtonStyle}"/>
                                <Button Content="T" Style="{StaticResource WeekdayButtonStyle}"/>
                                <Button Content="F" Style="{StaticResource WeekdayButtonStyle}"/>
                                <Button Content="S" Style="{StaticResource WeekdayButtonStyle}"/>
                                <Button Content="S" Style="{StaticResource WeekdayButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0 30 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Cancel"
                                Grid.Column="0"
                                Background="#D1D5DB"
                                Foreground="#1F2937"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Save Mission"
                                Grid.Column="2"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
