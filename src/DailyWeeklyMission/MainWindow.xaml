<Window x:Class="DailyWeeklyMission.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Daily Weekly Mission"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="NoteBackgroundBrush" Color="#FFF9E8"/>
        <SolidColorBrush x:Key="NoteLineBrush" Color="#F5C542"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F7DF6"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A9ADB5"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#F2CE57"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MissionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFDF2"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0 8 0 10"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MissionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="MissionContentStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Margin" Value="0 5 0 0"/>
        </Style>

        <Style x:Key="WeekdayCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#FFE178"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Background="{StaticResource NoteBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="#F4D05A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="8"
                              Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Daily Weekly Mission"
                           Margin="14 0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0 0 12 0">
                    <Button Content="H"
                            ToolTip="Mission history"
                            Style="{StaticResource IconButtonStyle}"/>
                    <Button Content="x"
                            ToolTip="Close"
                            Click="CloseButtonClick"
                            Style="{StaticResource IconButtonStyle}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource NoteLineBrush}"/>

            <ScrollViewer Grid.Row="1"
                          Margin="18 14 18 12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Weekly Missions"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <Button Grid.Column="1"
                                Content="+"
                                ToolTip="Add weekly mission"
                                Style="{StaticResource AddButtonStyle}"/>
                    </Grid>
                    <Border Height="1"
                            Background="{StaticResource NoteLineBrush}"
                            Margin="0 8 0 0"/>

                    <Border Style="{StaticResource MissionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Exercise"
                                       Style="{StaticResource MissionTitleStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="Workout at the gym"
                                       Style="{StaticResource MissionContentStyle}"/>
                            <Border Grid.Row="2"
                                    Height="6"
                                    Margin="0 16 12 0"
                                    Background="#F7DC7A"
                                    CornerRadius="3">
                                <Grid>
                                    <Border Width="210"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="3"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="1/3"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="#374151"/>
                            <Ellipse Grid.Column="1"
                                     Width="22"
                                     Height="22"
                                     HorizontalAlignment="Right"
                                     Stroke="#CBD0D8"
                                     StrokeThickness="1.5"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MissionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cleaning"
                                       Style="{StaticResource MissionTitleStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="Clean the house"
                                       Style="{StaticResource MissionContentStyle}"/>
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Margin="0 14 0 0">
                                <Border Style="{StaticResource WeekdayCircleStyle}" Background="#D8E8FF">
                                    <TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Style="{StaticResource WeekdayCircleStyle}" Background="{StaticResource PrimaryBrush}">
                                    <TextBlock Text="T" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Style="{StaticResource WeekdayCircleStyle}">
                                    <TextBlock Text="W" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Style="{StaticResource WeekdayCircleStyle}" Background="#D8E8FF">
                                    <TextBlock Text="T" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Style="{StaticResource WeekdayCircleStyle}">
                                    <TextBlock Text="F" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Style="{StaticResource WeekdayCircleStyle}">
                                    <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Style="{StaticResource WeekdayCircleStyle}">
                                    <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </StackPanel>
                            <Ellipse Grid.Column="1"
                                     Width="22"
                                     Height="22"
                                     HorizontalAlignment="Right"
                                     Stroke="#CBD0D8"
                                     StrokeThickness="1.5"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0 12 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Daily Missions"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <Button Grid.Column="1"
                                Content="+"
                                ToolTip="Add daily mission"
                                Style="{StaticResource AddButtonStyle}"/>
                    </Grid>
                    <Border Height="1"
                            Background="{StaticResource NoteLineBrush}"
                            Margin="0 8 0 0"/>

                    <Border Style="{StaticResource MissionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Read Books"
                                       Style="{StaticResource MissionTitleStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Text="Read for 30 minutes"
                                       Style="{StaticResource MissionContentStyle}"/>
                            <Border Grid.Row="2"
                                    Height="6"
                                    Margin="0 16 12 0"
                                    Background="#F7DC7A"
                                    CornerRadius="3">
                                <Grid>
                                    <Border Width="120"
                                            HorizontalAlignment="Left"
                                            Background="#9CC8FF"
                                            CornerRadius="3"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="0/1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="#374151"/>
                            <Ellipse Grid.Column="1"
                                     Width="22"
                                     Height="22"
                                     HorizontalAlignment="Right"
                                     Stroke="#CBD0D8"
                                     StrokeThickness="1.5"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
